<!doctype HTML>
<html>
	<head>
		<title>MyIcon CheatSheet</title>
		<meta charset="utf-8">
		<script>
			{{{loaderText}}}
			{{{embedText}}}
			{{#with cssFiles}}
			grunticon(["{{svg}}", "{{png}}", "{{fallback}}"], grunticon.svgLoadedCallback );
		</script>
		<noscript><link href="{{fallback}}" rel="stylesheet"></noscript>
		{{/with}}
	</head>
	<body>

		<h1>MyIcon CheatSheet</h1>
		{{#each icons}}
			{{#with this}}
			<span {{selectorType}}="{{selectorString}}{{name}}" data-grunticon-embed></span>{{prefix}}{{name}}<br>
			{{/with}}
		{{/each}}
		<style>
			@import url('https://fonts.googleapis.com/css?family=Roboto+Condensed');
			body, button{
				font-family: 'Roboto Condensed', sans-serif;
			}
            span[class^='mi-']{
                display: inline-block;
                vertical-align: text-top;
                width: 16px;
                height: 16px;
                margin-right: 5px;
				fill: currentColor;
            }
		</style>
</body>
</html>